{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.smalltrader.app/mobile/v1/offline-sale-intake-request.json",
  "title": "OfflineSaleIntakeRequest",
  "description": "Offline sale intake request schema for event_version 2 (contract revision 3). Only event_version 2 is accepted for new capture; legacy event_version 1 maps to HTTP 409 and client outbox CONFLICT.",
  "type": "object",
  "required": [
    "client_event_id",
    "device_id",
    "captured_at",
    "payload_digest",
    "event"
  ],
  "properties": {
    "client_event_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "event": {
      "type": "object",
      "required": [
        "client_event_id",
        "event_version",
        "company_id",
        "actor_id",
        "device_id",
        "device_lease_id",
        "captured_at",
        "customer_id",
        "currency",
        "warehouse_id",
        "cash_account_id",
        "catalog_snapshot_version",
        "local_receipt_number",
        "lines",
        "payment"
      ],
      "properties": {
        "client_event_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "event_version": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2,
          "description": "Must be 2 for contract revision 3 capture. Legacy v1 events are rejected with HTTP 409 conflict."
        },
        "company_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "device_lease_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "customer_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "warehouse_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "cash_account_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "catalog_snapshot_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "local_receipt_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "product_id",
              "product_unit_id",
              "unit_id",
              "conversion_to_base",
              "quantity",
              "unit_price",
              "tax_rate_id",
              "tax_rate",
              "tax_inclusive",
              "tax_amount",
              "line_total"
            ],
            "properties": {
              "product_id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "product_unit_id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "unit_id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "conversion_to_base": {
                "type": "string",
                "pattern": "^(?:0\\.(?=[0-9]{1,6}$)[0-9]*[1-9][0-9]*|[1-9][0-9]{0,13}(?:\\.[0-9]{1,6})?)$"
              },
              "quantity": {
                "type": "string",
                "pattern": "^(?:0\\.(?=[0-9]{1,6}$)[0-9]*[1-9][0-9]*|[1-9][0-9]{0,13}(?:\\.[0-9]{1,6})?)$"
              },
              "unit_price": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
              },
              "tax_rate_id": {
                "type": ["string", "null"],
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "tax_rate": {
                "type": "string",
                "pattern": "^(?:100(?:\\.0{1,6})?|(?:0|[1-9][0-9]?)(?:\\.[0-9]{1,6})?)$"
              },
              "tax_inclusive": {
                "type": "boolean"
              },
              "tax_amount": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
              },
              "line_total": {
                "type": "string",
                "pattern": "^(?:0\\.(?=[0-9]{1,6}$)[0-9]*[1-9][0-9]*|[1-9][0-9]{0,13}(?:\\.[0-9]{1,6})?)$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "tax_rate_id": {
                      "type": "null"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "tax_rate": {
                      "const": "0.000000"
                    },
                    "tax_inclusive": {
                      "const": false
                    }
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        },
        "payment": {
          "type": "object",
          "required": [
            "mode",
            "payment_method",
            "cash_account_id",
            "amount_tendered",
            "amount_settled",
            "change_returned"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["full"]
            },
            "payment_method": {
              "type": "string",
              "enum": ["cash"]
            },
            "cash_account_id": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "amount_tendered": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
            },
            "amount_settled": {
              "type": "string",
              "pattern": "^(?:0\\.(?=[0-9]{1,6}$)[0-9]*[1-9][0-9]*|[1-9][0-9]{0,13}(?:\\.[0-9]{1,6})?)$"
            },
            "change_returned": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
