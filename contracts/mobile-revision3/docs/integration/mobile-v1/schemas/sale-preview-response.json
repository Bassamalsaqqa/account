{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.smalltrader.app/mobile/v1/sale-preview-response.json",
  "title": "SalePreviewResponse",
  "description": "Sale preview response schema for contract revision 3 with explicit line tax identity, mode, and packaging conversion snapshot.",
  "type": "object",
  "required": [
    "company_id",
    "customer_id",
    "warehouse_id",
    "currency",
    "subtotal",
    "tax_total",
    "grand_total",
    "amount_due",
    "change",
    "lines",
    "payload_digest",
    "preview_token",
    "expires_at"
  ],
  "properties": {
    "company_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "customer_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "warehouse_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "subtotal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
    },
    "tax_total": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
    },
    "grand_total": {
      "type": "string",
      "pattern": "^(?:0\\.(?=[0-9]{1,6}$)[0-9]*[1-9][0-9]*|[1-9][0-9]{0,13}(?:\\.[0-9]{1,6})?)$"
    },
    "amount_due": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
    },
    "change": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "product_id",
          "product_unit_id",
          "conversion_to_base",
          "quantity",
          "unit_price",
          "tax_rate_id",
          "tax_rate",
          "tax_inclusive",
          "tax_amount",
          "line_total"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "product_unit_id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "conversion_to_base": {
            "type": "string",
            "pattern": "^(?:0\\.(?=[0-9]{1,6}$)[0-9]*[1-9][0-9]*|[1-9][0-9]{0,13}(?:\\.[0-9]{1,6})?)$"
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?:0\\.(?=[0-9]{1,6}$)[0-9]*[1-9][0-9]*|[1-9][0-9]{0,13}(?:\\.[0-9]{1,6})?)$"
          },
          "unit_price": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
          },
          "tax_rate_id": {
            "type": ["string", "null"],
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "tax_rate": {
            "type": "string",
            "pattern": "^(?:100(?:\\.0{1,6})?|(?:0|[1-9][0-9]?)(?:\\.[0-9]{1,6})?)$"
          },
          "tax_inclusive": {
            "type": "boolean"
          },
          "tax_amount": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
          },
          "line_total": {
            "type": "string",
            "pattern": "^(?:0\\.(?=[0-9]{1,6}$)[0-9]*[1-9][0-9]*|[1-9][0-9]{0,13}(?:\\.[0-9]{1,6})?)$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "tax_rate_id": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "tax_rate": {
                  "const": "0.000000"
                },
                "tax_inclusive": {
                  "const": false
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "preview_token": {
      "type": "string",
      "minLength": 32,
      "maxLength": 16384
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
