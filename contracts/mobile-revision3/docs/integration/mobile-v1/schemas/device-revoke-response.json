{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.smalltrader.app/mobile/v1/device-revoke-response.json",
  "title": "DeviceRevokeResponse",
  "type": "object",
  "required": ["device_id", "status", "revoked_at"],
  "properties": {
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "status": {
      "type": "string",
      "enum": ["revoked"]
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
