{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.smalltrader.app/mobile/v1/archived-v1-sale-preview-request.json",
  "title": "ArchivedV1SalePreviewRequest",
  "description": "Archived compatibility schema for mobile v1 sale preview request. Preserved for historical test vectors; revision 3 requires explicit tax_rate_id, tax_inclusive, and conversion_to_base.",
  "type": "object",
  "required": [
    "client_event_id",
    "device_id",
    "customer_id",
    "warehouse_id",
    "currency",
    "lines",
    "payment"
  ],
  "properties": {
    "client_event_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "customer_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "warehouse_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "product_id",
          "product_unit_id",
          "quantity",
          "unit_price",
          "tax_rate"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "product_unit_id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?:0\\.(?=[0-9]{1,6}$)[0-9]*[1-9][0-9]*|[1-9][0-9]{0,13}(?:\\.[0-9]{1,6})?)$"
          },
          "unit_price": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
          },
          "tax_rate": {
            "type": "string",
            "pattern": "^(?:100(?:\\.0{1,6})?|(?:0|[1-9][0-9]?)(?:\\.[0-9]{1,6})?)$"
          }
        },
        "additionalProperties": false
      }
    },
    "payment": {
      "type": "object",
      "required": ["settlement_mode", "amount"],
      "properties": {
        "settlement_mode": {
          "type": "string",
          "enum": ["unpaid", "full", "partial"]
        },
        "payment_method": {
          "type": ["string", "null"],
          "enum": ["cash", null]
        },
        "cash_account_id": {
          "type": ["string", "null"],
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "amount": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
