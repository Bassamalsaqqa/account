# ==============================================================================
# Small Trader Accounting — Production Environment Configuration for Hostinger
# Target Host: account.palsync.net
# Private Application Path: /home/u556956644/domains/palsync.net/accounting/.env
# NOTE: Never place this file inside public_html or expose it over HTTP/HTTPS.
# ==============================================================================

APP_NAME="التاجر الصغير"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://account.palsync.net

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Hostinger Local MySQL Database
# Connect to 127.0.0.1 on the server (do NOT use external srv*.hstgr.io from the PHP app)
# Values MUST be obtained from Hostinger hPanel -> Databases -> Management. Do not guess these values.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Registration: Strictly disabled for private deployment
# Initial user is created via CLI: php artisan app:create-user
REGISTRATION_ENABLED=false

# Session & Security (Database-backed for shared hosting compatibility)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache & Queues (Database-backed; no Redis or Supervisor needed)
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail Configuration (Required for password reset delivery in production)
# Configure with your verified SMTP provider (e.g. Hostinger Business Email, Postmark, Mailgun, Brevo).
# WARNING: If left as MAIL_MAILER=log or unconfigured, password reset links will only appear in
# storage/logs/laravel.log and will NOT be delivered to user inboxes.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Frontend
VITE_APP_NAME="${APP_NAME}"
