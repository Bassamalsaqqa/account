{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MobileV2AdvancedProbeEvidence",
  "description": "Authoritative contract schema for Mobile V2 Advanced Probe Evidence (Lost ACK Recovery & Rollback Probes) under explicit Root coordination. Completely separate from the basic EDA evidence contract.",
  "type": "object",
  "required": [
    "contract_version",
    "scope",
    "run_id",
    "company_id",
    "schema_name",
    "backend_head",
    "android_publication_head",
    "android_executable_head",
    "scenarios",
    "lost_ack_recovery_evidence",
    "rollback_probes_evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "v2_advanced_probe_evidence_v1"
    },
    "scope": {
      "type": "string",
      "const": "ROOT_AUTHORIZED_ADVANCED_PROBE_EXECUTION"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "company_id": {
      "type": "integer",
      "minimum": 1
    },
    "schema_name": {
      "type": "string",
      "pattern": "^accounting_p8_tmp_[0-9a-f]{12}$"
    },
    "backend_head": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "android_publication_head": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "android_executable_head": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "scenarios": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["name", "status", "httpStatusCode"],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "readiness_probe",
              "financial_cash_fresh_commit_201",
              "financial_cash_idempotent_replay_200",
              "financial_cash_event_status_posted",
              "financial_cash_tamper_409",
              "transport_lost_ack_recovery",
              "stock_permission_rollback_probes"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "NOT_RUN"]
          },
          "httpStatusCode": {
            "type": ["integer", "null"]
          }
        }
      }
    },
    "lost_ack_recovery_evidence": {
      "type": "object",
      "required": [
        "suppression_mode",
        "target_client_event_id",
        "server_commit_verified_before_suppression",
        "suppression_witness_file",
        "recovery_method",
        "recovery_http_status",
        "receipt_status",
        "matching_payload_digest",
        "sales_invoice_public_id",
        "customer_payment_public_id"
      ],
      "additionalProperties": false,
      "properties": {
        "suppression_mode": {
          "type": "string",
          "const": "TEST_TRANSPORT_BOUNDARY_SINGLE_RESPONSE_DROP"
        },
        "target_client_event_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "server_commit_verified_before_suppression": {
          "type": "boolean",
          "const": true
        },
        "suppression_witness_file": {
          "type": "string"
        },
        "recovery_method": {
          "type": "string",
          "const": "RETAINED_EVENT_GET_STATUS"
        },
        "recovery_http_status": {
          "type": "integer",
          "const": 200
        },
        "receipt_status": {
          "type": "string",
          "const": "completed"
        },
        "matching_payload_digest": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "sales_invoice_public_id": {
          "type": "string",
          "minLength": 26,
          "maxLength": 26
        },
        "customer_payment_public_id": {
          "type": "string",
          "minLength": 26,
          "maxLength": 26
        }
      }
    },
    "rollback_probes_evidence": {
      "type": "object",
      "required": [
        "probes_count",
        "probes"
      ],
      "additionalProperties": false,
      "properties": {
        "probes_count": {
          "type": "integer",
          "minimum": 1
        },
        "probes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "probe_name",
              "client_event_id",
              "expected_http_status",
              "actual_http_status",
              "economic_delta_zero",
              "reconciliations_healthy",
              "issue_count"
            ],
            "additionalProperties": false,
            "properties": {
              "probe_name": {
                "type": "string",
                "enum": [
                  "permission_denial",
                  "insufficient_stock",
                  "controlled_fault_after_draft",
                  "controlled_fault_after_posting",
                  "controlled_fault_after_payment"
                ]
              },
              "client_event_id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "expected_http_status": {
                "type": "integer"
              },
              "actual_http_status": {
                "type": "integer"
              },
              "economic_delta_zero": {
                "type": "boolean",
                "const": true
              },
              "reconciliations_healthy": {
                "type": "boolean",
                "const": true
              },
              "issue_count": {
                "type": "integer",
                "const": 0
              }
            }
          }
        }
      }
    }
  }
}
