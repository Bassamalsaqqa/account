{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MobileV2ClientHandoff",
  "description": "Concrete minimal runtime cash handoff artifact for Mobile V2 Android client pairing",
  "type": "object",
  "required": [
    "schema_version",
    "handoff_scope",
    "backend_runtime_pins",
    "endpoints",
    "fixture",
    "credentials_path",
    "sample_raw_wire_request",
    "server_synthesized_context",
    "canonical_intent_profile_digest",
    "startup_tls"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "handoff_scope": {
      "type": "string",
      "enum": ["mobile_v2_online_cash_sale"]
    },
    "backend_runtime_pins": {
      "type": "object",
      "required": [
        "qualified_core_head_sha",
        "backend_execution_head_sha",
        "qualified_app_tree_sha",
        "peer_android_approved_head_sha"
      ],
      "properties": {
        "qualified_core_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "backend_execution_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "qualified_app_tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "peer_android_approved_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "peer_android_executable_head_sha": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "endpoints": {
      "type": "object",
      "required": [
        "base_url",
        "loopback_base_url",
        "routes"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "loopback_base_url": {
          "type": "string",
          "format": "uri"
        },
        "routes": {
          "type": "object",
          "required": [
            "online_cash_sale",
            "offline_event_status",
            "readiness_probe"
          ],
          "properties": {
            "online_cash_sale": {
              "type": "string"
            },
            "offline_event_status": {
              "type": "string"
            },
            "readiness_probe": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "required": [
        "schema_name",
        "company_public_id",
        "company_base_currency",
        "staff_actor_public_id",
        "device_id",
        "customer_public_id",
        "warehouse_public_id",
        "product_public_id",
        "product_unit_public_id",
        "tax_rate_public_id",
        "cash_account_public_id"
      ],
      "properties": {
        "schema_name": {
          "type": "string"
        },
        "company_public_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "company_base_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "staff_actor_public_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "customer_public_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "warehouse_public_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "product_public_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "product_unit_public_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "tax_rate_public_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "cash_account_public_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "sample_event_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "credentials_path": {
      "type": "string",
      "description": "Path to private 0600 file holding raw_token and token_hash"
    },
    "sample_raw_wire_request": {
      "type": "object",
      "required": [
        "client_event_id",
        "device_id",
        "customer_id",
        "warehouse_id",
        "currency",
        "lines",
        "payment"
      ],
      "properties": {
        "client_event_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "customer_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "warehouse_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "product_id",
              "product_unit_id",
              "conversion_to_base",
              "quantity",
              "unit_price",
              "tax_rate_id",
              "tax_rate",
              "tax_inclusive"
            ],
            "properties": {
              "product_id": {"type": "string"},
              "product_unit_id": {"type": "string"},
              "conversion_to_base": {"type": "string"},
              "quantity": {"type": "string"},
              "unit_price": {"type": "string"},
              "tax_rate_id": {"type": "string"},
              "tax_rate": {"type": "string"},
              "tax_inclusive": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "payment": {
          "type": "object",
          "required": [
            "settlement_mode",
            "payment_method",
            "cash_account_id",
            "amount"
          ],
          "properties": {
            "settlement_mode": {"type": "string", "enum": ["full", "split", "unpaid"]},
            "payment_method": {"type": ["string", "null"], "enum": ["cash", null]},
            "cash_account_id": {"type": ["string", "null"]},
            "amount": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "server_synthesized_context": {
      "type": "object",
      "required": [
        "company_id",
        "actor_id",
        "currency_minor_units"
      ],
      "properties": {
        "company_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "currency_minor_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      },
      "additionalProperties": false
    },
    "canonical_intent_profile_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "startup_tls": {
      "type": "object",
      "required": [
        "status",
        "ca_cert_path",
        "ca_cert_sha256",
        "readiness_url",
        "readiness_nonce"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["UNAVAILABLE_AWAITING_TLS_START", "ACTIVE_TLS_READY", "ACTIVE"]
        },
        "ca_cert_path": {
          "type": ["string", "null"]
        },
        "ca_cert_sha256": {
          "type": ["string", "null"]
        },
        "readiness_url": {
          "type": ["string", "null"]
        },
        "readiness_nonce": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
