{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.smalltrader.app/mobile/v1/auth-login-response.json",
  "title": "AuthLoginResponse",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "token",
        "token_type",
        "expires_at",
        "actor",
        "companies"
      ],
      "properties": {
        "token": {
          "type": "string",
          "minLength": 20
        },
        "token_type": {
          "type": "string",
          "enum": [
            "Bearer"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "object",
          "required": [
            "id",
            "name",
            "email",
            "role",
            "password_epoch"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "role": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "Presentation label only; never an authorization grant."
            },
            "password_epoch": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "companies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "base_currency",
              "is_default"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "base_currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "is_default": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "status",
        "retry"
      ],
      "properties": {
        "status": {
          "const": "MFA_REQUIRED"
        },
        "retry": {
          "const": "fresh_challenge"
        }
      },
      "additionalProperties": false
    }
  ]
}
