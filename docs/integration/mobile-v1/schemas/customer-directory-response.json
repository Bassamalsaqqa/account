{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.smalltrader.app/mobile/v1/customer-directory-response.json",
  "title": "CustomerDirectoryResponse",
  "type": "object",
  "required": [
    "company_id",
    "generated_at",
    "next_cursor",
    "has_more",
    "customers"
  ],
  "properties": {
    "company_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_cursor": {
      "type": ["string", "null"],
      "maxLength": 255
    },
    "has_more": {
      "type": "boolean"
    },
    "customers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "code", "name", "is_walk_in"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "phone": {
            "type": ["string", "null"],
            "maxLength": 32
          },
          "is_walk_in": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
