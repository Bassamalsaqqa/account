{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.smalltrader.app/mobile/v1/product-catalog-response.json",
  "title": "ProductCatalogResponse",
  "type": "object",
  "required": [
    "company_id",
    "catalog_snapshot_version",
    "generated_at",
    "next_cursor",
    "has_more",
    "products"
  ],
  "properties": {
    "company_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "catalog_snapshot_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "has_more": {
      "type": "boolean"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sku",
          "name",
          "unit_price",
          "tax_rate",
          "tax_rate_id",
          "is_tracked",
          "available_quantity",
          "base_unit",
          "default_unit",
          "units"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "barcode": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "unit_price": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
          },
          "tax_rate": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:100(?:\\.0{1,6})?|(?:0|[1-9][0-9]?)(?:\\.[0-9]{1,6})?)$"
          },
          "tax_rate_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "description": "Null pair means no product default tax association, never zero tax or exemption. Mature Product has no tax FK; return null pair."
          },
          "is_tracked": {
            "type": "boolean"
          },
          "available_quantity": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
          },
          "base_unit": {
            "type": "object",
            "required": [
              "id",
              "code",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "additionalProperties": false
          },
          "default_unit": {
            "type": "object",
            "required": [
              "unit_id",
              "product_unit_id",
              "conversion_to_base",
              "sale_price"
            ],
            "properties": {
              "unit_id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "product_unit_id": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              },
              "conversion_to_base": {
                "type": "string",
                "pattern": "^(?:0\\.(?=[0-9]{1,6}$)[0-9]*[1-9][0-9]*|[1-9][0-9]{0,13}(?:\\.[0-9]{1,6})?)$"
              },
              "sale_price": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
              }
            },
            "additionalProperties": false
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "product_unit_id",
                "unit_id",
                "code",
                "name",
                "conversion_to_base",
                "is_base",
                "is_default_sale"
              ],
              "properties": {
                "product_unit_id": {
                  "type": "string",
                  "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                },
                "unit_id": {
                  "type": "string",
                  "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                },
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "conversion_to_base": {
                  "type": "string",
                  "pattern": "^(?:0\\.(?=[0-9]{1,6}$)[0-9]*[1-9][0-9]*|[1-9][0-9]{0,13}(?:\\.[0-9]{1,6})?)$"
                },
                "is_base": {
                  "type": "boolean"
                },
                "is_default_sale": {
                  "type": "boolean"
                },
                "sale_price": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^(?:0|[1-9][0-9]{0,13})(?:\\.[0-9]{1,6})?$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "tax_rate_id": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "tax_rate": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "tax_rate": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
