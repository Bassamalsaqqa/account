{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HomeDashboardResponse",
  "type": "object",
  "required": [
    "company_id",
    "today",
    "sales_today_count",
    "sales_today_total",
    "cash_in_drawer",
    "low_stock_count",
    "total_receivables",
    "total_payables",
    "recent_invoices",
    "business_info"
  ],
  "properties": {
    "company_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "today": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sales_today_count": { "type": "integer", "minimum": 0 },
    "sales_today_total": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
    "cash_in_drawer": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
    "low_stock_count": { "type": "integer", "minimum": 0 },
    "total_receivables": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
    "total_payables": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
    "recent_invoices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "invoice_number",
          "customer_name",
          "date",
          "total",
          "paid",
          "remaining",
          "currency",
          "payment_status"
        ],
        "properties": {
          "id": { "type": "string" },
          "invoice_number": { "type": "string" },
          "customer_name": { "type": "string" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "total": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
          "paid": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
          "remaining": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "payment_status": { "type": "string", "enum": ["PAID_CASH", "PARTIAL", "ON_CREDIT"] }
        }
      }
    },
    "business_info": {
      "type": "object",
      "required": [
        "name_ar",
        "name_en",
        "default_currency"
      ],
      "properties": {
        "name_ar": { "type": "string" },
        "name_en": { "type": "string" },
        "city_ar": { "type": "string" },
        "city_en": { "type": "string" },
        "phone": { "type": "string" },
        "tax_number": { "type": "string" },
        "default_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "default_currency_minor_units": { "type": "integer", "minimum": 0, "maximum": 4 }
      }
    }
  }
}
