{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SalesInvoicePreviewRequest",
  "type": "object",
  "required": ["lines"],
  "properties": {
    "customer_id": { "type": ["string", "null"] },
    "currency_code": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["product_id", "quantity", "unit_price"],
        "properties": {
          "product_id": { "type": "string" },
          "unit_id": { "type": ["string", "null"] },
          "quantity": { "type": "string", "pattern": "^\\d+(\\.\\d{1,6})?$" },
          "unit_price": { "type": "string", "pattern": "^\\d+(\\.\\d{1,4})?$" },
          "tax_rate_id": { "type": ["string", "null"] },
          "tax_rate": { "type": ["string", "null"], "pattern": "^\\d+(\\.\\d{1,6})?$" },
          "is_tax_inclusive": { "type": "boolean" },
          "discount_amount": { "type": ["string", "null"], "pattern": "^\\d+(\\.\\d{1,4})?$" }
        }
      }
    }
  }
}
