{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SalesInvoiceDetailResponse",
  "type": "object",
  "required": [
    "id",
    "company_id",
    "invoice_number",
    "status",
    "payment_status",
    "customer_id",
    "date",
    "currency",
    "currency_minor_units",
    "subtotal",
    "discount",
    "tax",
    "total",
    "paid",
    "remaining",
    "lines",
    "thermal_receipt"
  ],
  "properties": {
    "id": { "type": "string" },
    "company_id": { "type": "string" },
    "invoice_number": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "posted", "void"] },
    "payment_status": { "type": "string", "enum": ["PAID_CASH", "PAID", "PARTIAL", "ON_CREDIT"] },
    "customer_id": { "type": "string" },
    "customer_name": { "type": ["string", "null"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "currency": { "type": "string" },
    "currency_minor_units": { "type": "integer" },
    "subtotal": { "type": "string" },
    "discount": { "type": "string" },
    "tax": { "type": "string" },
    "total": { "type": "string" },
    "paid": { "type": "string" },
    "remaining": { "type": "string" },
    "lines": {
      "type": "array",
      "items": { "$ref": "#/$defs/salesInvoiceLineItem" }
    },
    "thermal_receipt": {
      "type": "object",
      "required": [
        "invoice_number",
        "date_time",
        "subtotal",
        "discount",
        "tax",
        "grand_total",
        "paid_amount",
        "remaining_balance",
        "currency",
        "lines"
      ],
      "properties": {
        "store_name_ar": { "type": ["string", "null"] },
        "store_name_en": { "type": ["string", "null"] },
        "city_ar": { "type": ["string", "null"] },
        "city_en": { "type": ["string", "null"] },
        "phone": { "type": ["string", "null"] },
        "tax_number": { "type": ["string", "null"] },
        "invoice_number": { "type": "string" },
        "date_time": { "type": "string" },
        "cashier": { "type": ["string", "null"] },
        "customer_name": { "type": ["string", "null"] },
        "subtotal": { "type": "string" },
        "discount": { "type": "string" },
        "tax": { "type": "string" },
        "grand_total": { "type": "string" },
        "paid_amount": { "type": "string" },
        "remaining_balance": { "type": "string" },
        "currency": { "type": "string" },
        "lines": {
          "type": "array",
          "items": { "$ref": "#/$defs/salesInvoiceLineItem" }
        }
      }
    }
  },
  "$defs": {
    "salesInvoiceLineItem": {
      "type": "object",
      "required": [
        "id",
        "product_name",
        "unit",
        "quantity",
        "unit_price",
        "line_total",
        "tax_rate",
        "discount"
      ],
      "properties": {
        "id": { "type": "string" },
        "product_id": { "type": ["string", "null"] },
        "product_name": { "type": "string" },
        "unit": { "type": "string" },
        "quantity": { "type": "string" },
        "unit_price": { "type": "string" },
        "line_total": { "type": "string" },
        "tax_rate": { "type": "string" },
        "discount": { "type": "string" }
      }
    }
  }
}
