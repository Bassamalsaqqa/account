{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SalesInvoiceIndexResponse",
  "type": "object",
  "required": [
    "company_id",
    "count",
    "has_more",
    "invoices"
  ],
  "properties": {
    "company_id": { "type": "string" },
    "count": { "type": "integer" },
    "has_more": { "type": "boolean" },
    "invoices": {
      "type": "array",
      "items": { "$ref": "#/$defs/salesInvoiceListItem" }
    }
  },
  "$defs": {
    "salesInvoiceListItem": {
      "type": "object",
      "required": [
        "id",
        "invoice_number",
        "status",
        "customer_id",
        "date",
        "subtotal",
        "discount",
        "tax",
        "total",
        "paid",
        "remaining",
        "currency",
        "currency_minor_units",
        "payment_status",
        "created_at"
      ],
      "properties": {
        "id": { "type": "string" },
        "invoice_number": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "posted", "void"] },
        "customer_id": { "type": "string" },
        "customer_name": { "type": ["string", "null"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "subtotal": { "type": "string" },
        "discount": { "type": "string" },
        "tax": { "type": "string" },
        "total": { "type": "string" },
        "paid": { "type": "string" },
        "remaining": { "type": "string" },
        "currency": { "type": "string" },
        "currency_minor_units": { "type": "integer" },
        "payment_status": { "type": "string", "enum": ["PAID_CASH", "PAID", "PARTIAL", "ON_CREDIT"] },
        "created_at": { "type": ["string", "null"] }
      }
    }
  }
}
