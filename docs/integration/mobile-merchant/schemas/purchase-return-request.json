{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PurchaseReturnRequest",
  "type": "object",
  "required": [
    "purchase_id",
    "lines"
  ],
  "properties": {
    "purchase_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "warehouse_id": { "type": ["string", "null"], "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "goods_receipt_note_id": { "type": ["string", "null"], "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "reason": { "type": ["string", "null"] },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "purchase_line_id": { "type": ["string", "null"], "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
          "product_id": { "type": ["string", "null"], "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
          "quantity": { "type": ["string", "number"] }
        }
      }
    }
  }
}
