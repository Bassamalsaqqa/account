{
  "contract_version": "2026-11-18.2",
  "title": "Small Trader Native Mobile Backend Authoritative Capabilities Contract",
  "description": "Comprehensive native contract tying each surface to actual route registration, request/response DTO schemas, server-authoritative decimal precision, and test coverage.",
  "base_path_v1": "/api/mobile/v1",
  "base_path_v2": "/api/mobile/v2",
  "auth_mechanism": "Bearer token via Authorization header (MobileAccessToken)",
  "boundaries": {
    "v1": "App\\Http\\Middleware\\MobileApiBoundary + App\\Http\\Middleware\\MobileAuthenticate",
    "v2": "App\\Http\\Middleware\\MobileV2ApiBoundary + App\\Http\\Middleware\\MobileV2Authenticate"
  },
  "global_invariants": {
    "currency_minor_units": "Server authoritative integer via CurrencyMinorUnitsResolver. Android clients MUST NOT use fallback-2 or assume ILS/USD.",
    "actor_permissions": "Evaluated per request using setPermissionsTeamId($company->id). Android clients must NOT invent role or grant assumptions.",
    "pricing_and_costs": "Nullable decimal strings. When unpriced or cost-unauthorized, values are NULL; clients MUST NOT coerce null to 0.00.",
    "quantities": "Exact string decimals up to 4-6 digits. Fractional quantities (e.g., 1.2500 kg) MUST NEVER be truncated or cast to integer.",
    "tenant_isolation": "Strict cross-company isolation enforced by route boundary. Unowned or cross-tenant IDs return 404 or 403.",
    "durability_and_idempotency": "V2 transactions require client_event_id and server digest acknowledgement before terminal state."
  },
  "capabilities": [
